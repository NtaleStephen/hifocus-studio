# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_PROJECT_ID=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_SUPABASE_URL=""

# ─── Database (Supabase PostgreSQL) ──────────────────────────────────────────
# Connect to Supabase via connection pooling (used at runtime)
DATABASE_URL=""

# Direct connection to the database (used for migrations)
DIRECT_URL=""

# ─── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_FLOW=""
STRIPE_PRICE_ID_DEEP_WORK=""
STRIPE_PRICE_ID_STUDIO=""

# ─── App ─────────────────────────────────────────────────────────────────────
# REQUIRED for production — Stripe redirects back to this URL
NEXT_PUBLIC_APP_URL="https://your-production-domain.com"

# ─── Admin ───────────────────────────────────────────────────────────────────
# Comma-separated emails granted access to the /admin dashboard.
ADMIN_EMAILS="you@example.com"

# ─── Email (Resend) + Cron ───────────────────────────────────────────────────
# Billing-reminder emails (7 days before renewal), sent by the daily cron.
RESEND_API_KEY=""
RESEND_FROM="Hifocus <billing@your-verified-domain.com>"
# Secret Vercel Cron sends as a Bearer token; also required to call the cron route.
CRON_SECRET=""
